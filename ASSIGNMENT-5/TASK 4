#include <iostream>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>
using namespace std;

class Bill {
protected:
    string patient;
public:
    explicit Bill(string p) : patient(move(p)) {}

    virtual ~Bill() = default;

    virtual double total() const = 0;
    virtual string type() const = 0;

    string patientName() const {
        return patient;
    }
};

class OutPatientBill : public Bill {
    double consultation, tests;

public:
    OutPatientBill(string p, double c, double t)
        : Bill(move(p)), consultation(c), tests(t) {
        if (c < 0 || t < 0)
            throw invalid_argument("Negative outpatient charge");
    }

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OP";
    }
};

class InPatientBill : public Bill {
    int days;
    double rate, surgery;

public:
    InPatientBill(string p, int d, double r, double s)
        : Bill(move(p)), days(d), rate(r), surgery(s) {
        if (d < 0 || r < 0 || s < 0)
            throw invalid_argument("Negative inpatient charge");
    }

    double total() const override {
        return days * rate + surgery;
    }

    string type() const override {
        return "IP";
    }
};

class PharmacyBill : public Bill {
    int units;
    double unitPrice;

public:
    PharmacyBill(string p, int u, double price)
        : Bill(move(p)), units(u), unitPrice(price) {
        if (u < 0 || price < 0)
            throw invalid_argument("Negative pharmacy charge");
    }

    double total() const override {
        return units * unitPrice;
    }

    string type() const override {
        return "Pharmacy";
    }
};

class Payer {
public:
    virtual ~Payer() = default;

    virtual string name() const = 0;
    virtual double amountCovered(const Bill&) const = 0;
};

class SelfPay : public Payer {
public:
    string name() const override {
        return "SelfPay";
    }

    double amountCovered(const Bill& b) const override {
        return b.total();
    }
};

class EmployeePayer : public Payer {
    double percentage;

public:
    explicit EmployeePayer(double p) : percentage(p) {
        if (p < 0 || p > 100)
            throw invalid_argument("Invalid employee coverage");
    }

    string name() const override {
        return "EmployeeScheme";
    }

    double amountCovered(const Bill& b) const override {
        return b.total() * percentage / 100.0;
    }
};

int main() {
    try {
        vector<unique_ptr<Bill>> bills;

        bills.push_back(make_unique<OutPatientBill>("Ravi", 500, 1200));
        bills.push_back(make_unique<InPatientBill>("Meena", 3, 2500, 40000));
        bills.push_back(make_unique<PharmacyBill>("Kumar", 20, 260));

        vector<unique_ptr<Payer>> payers;

        payers.push_back(make_unique<SelfPay>());
        payers.push_back(make_unique<EmployeePayer>(75));

        for (const auto& b : bills) {
            cout << b->type() << " "
                 << b->patientName() << ": "
                 << b->total() << '\n';

            for (const auto& p : payers) {
                cout << p->name()
                     << " covers "
                     << p->amountCovered(*b) << '\n';
            }
        }

        try {
            PharmacyBill invalid("Test", -2, 100);
        }
        catch (const exception& e) {
            cout << "Error: " << e.what() << '\n';
        }

        cout << "ALL OPERATIONS COMPLETED\n";
    }
    catch (const exception& e) {
        cout << "Billing error: " << e.what() << '\n';
    }
    catch (...) {
        cout << "Unknown billing error\n";
    }
}
