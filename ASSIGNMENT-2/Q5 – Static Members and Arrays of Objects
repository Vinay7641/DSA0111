#include <iostream>
#include <string>
using namespace std;

class Token {

private:
    static int next;
    int id;

public:

    Token() {
        id = ++next;
    }

    int get() const {
        return id;
    }

    static int issued() {
        return next - 100;
    }
};

int Token::next = 100;

// Bus Ticket Class

class BusTicket {

private:
    static int issued;
    static const int CAPACITY = 3;

    int seat;
    string name;

public:

    explicit BusTicket(const string& n)
        : seat(0), name(n) {

        if (issued < CAPACITY) {
            issued++;
            seat = issued;
        }
    }

    static int count() {
        return issued;
    }

    void print() const {

        cout << name << ": ";

        if (seat != 0) {
            cout << "Seat " << seat;
        } else {
            cout << "Waiting";
        }

        cout << endl;
    }
};

int BusTicket::issued = 0;

int main() {

    // Token example

    Token counter[3];

    Token extra;

    cout << counter[0].get() << " "
         << counter[2].get() << " "
         << extra.get() << " "
         << Token::issued() << endl;

    // Bus ticket example

    BusTicket trip[4] = {
        BusTicket("Asha"),
        BusTicket("Bala"),
        BusTicket("Chitra"),
        BusTicket("Dev")
    };

    cout << "\nBus Ticket Details" << endl;

    for (const BusTicket& t : trip) {
        t.print();
    }

    cout << "Issued: "
         << BusTicket::count() << endl;

    return 0;
}
