#include <iostream>
#include <string>
using namespace std;

struct Parcel {
    double weight;
    bool express;
    bool insured;
};

// Function for weight in kilograms
double charge(double weight,
              bool express = false,
              bool insured = false) {

    double amount = weight * 50;

    if (express) {
        amount += 30;
    }

    if (insured) {
        amount += 20;
    }

    return amount;
}

// Function for weight in grams
double charge(int grams) {

    double weight = grams / 1000.0;

    return charge(weight);
}

// Function for Parcel object
double charge(Parcel p) {

    return charge(p.weight, p.express, p.insured);
}

int main() {

    cout << "Charge 1: "
         << charge(2) << endl;

    cout << "Charge 2: "
         << charge(2.0) << endl;

    cout << "Charge 3: "
         << charge(2.0f) << endl;

    cout << "Charge 4: "
         << charge(2, true) << endl;

    cout << "Charge 5: "
         << charge(2.0, true, true) << endl;

    Parcel p = {3.0, true, false};

    cout << "Charge 6: "
         << charge(p) << endl;

    return 0;
}
