
#include <iostream>
#include <string>
#include <vector>
#include <memory>
using namespace std;

class Staff {
private:
    string name;
    int id;

protected:
    static constexpr double DA_RATE = 0.42;

public:
    Staff(string n, int i) : name(n), id(i) {}

    virtual double pay() const = 0;

    void display() const {
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
        cout << "Salary: " << pay() << endl;
    }

    virtual ~Staff() = default;
};

class Professor : public Staff {
    double basic;
    double research;

public:
    Professor(string n, int i, double b, double r)
        : Staff(n, i), basic(b), research(r) {}

    double pay() const override {
        return basic + basic * DA_RATE + research;
    }
};

class LabAssistant : public Staff {
    double basic;

public:
    LabAssistant(string n, int i, double b)
        : Staff(n, i), basic(b) {}

    double pay() const override {
        return basic + basic * DA_RATE;
    }
};

class GuestFaculty : public Staff {
    double hours;
    double rate;

public:
    GuestFaculty(string n, int i, double h, double r)
        : Staff(n, i), hours(h), rate(r) {}

    double pay() const override {
        return hours * rate;
    }
};

int main() {
    vector<unique_ptr<Staff>> employees;

    employees.push_back(
        make_unique<Professor>("Arun", 101, 50000, 5000)
    );

    employees.push_back(
        make_unique<LabAssistant>("Kumar", 102, 30000)
    );

    employees.push_back(
        make_unique<GuestFaculty>("Priya", 103, 40, 800)
    );

    for (const auto& employee : employees) {
        employee->display();
        cout << endl;
    }

    return 0;
}
