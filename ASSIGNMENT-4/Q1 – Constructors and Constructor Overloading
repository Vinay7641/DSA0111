#include <iostream>
#include <string>
using namespace std;

class Book {
private:
    string title;
    string author;
    int copies;

public:
    Book() : Book("", "", 0) {}

    Book(string t) : Book(t, "Unknown", 1) {}

    Book(string t, string a) : Book(t, a, 1) {}

    Book(string t, string a, int c)
        : title(t), author(a), copies(c >= 0 ? c : 0) {}

    void display() const {
        cout << "Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Copies: " << copies << endl;
        cout << "-------------------" << endl;
    }
};

int main() {

    Book b1;

    Book b2("C++ Programming");

    Book b3("Data Structures", "Mark Allen", 5);

    Book b4("Computer Networks", "Andrew", -3);

    b1.display();
    b2.display();
    b3.display();
    b4.display();

    return 0;
}
