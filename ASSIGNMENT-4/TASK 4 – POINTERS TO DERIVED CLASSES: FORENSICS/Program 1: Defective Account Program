
#include <iostream>
using namespace std;

class Account {
public:
    double rate() const {
        return 3.5;
    }

    ~Account() {
        cout << "Account Destructor\n";
    }
};

class SeniorAccount : public Account {
    double* history;

public:
    SeniorAccount() {
        history = new double[100]{};
    }

    double rate() const {
        return 4.0;
    }

    ~SeniorAccount() {
        delete[] history;
        cout << "SeniorAccount Destructor\n";
    }
};

int main() {
    Account* accounts[2] = {
        new Account,
        new SeniorAccount
    };

    for (Account* a : accounts) {
        cout << a->rate() << '\n';
    }

    for (Account* a : accounts) {
        delete a;
    }

    Account copy = SeniorAccount();

    cout << "Copied Account Rate: "
         << copy.rate() << '\n';

    return 0;
}
