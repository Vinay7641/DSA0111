#include <iostream>
#include <cmath>
#include <iomanip>
#include <stdexcept>
using namespace std;

class Complex {

private:
    double real;
    double imag;

public:

    Complex() : real(0), imag(0) {}

    Complex(double r) : real(r), imag(0) {}

    Complex(double r, double i)
        : real(r), imag(i) {}

    Complex operator+(const Complex& c) const {
        return Complex(
            real + c.real,
            imag + c.imag
        );
    }

    Complex operator-(const Complex& c) const {
        return Complex(
            real - c.real,
            imag - c.imag
        );
    }

    Complex operator*(const Complex& c) const {
        return Complex(
            real * c.real - imag * c.imag,
            real * c.imag + imag * c.real
        );
    }

    Complex operator/(const Complex& c) const {

        double denominator =
            c.real * c.real + c.imag * c.imag;

        if (denominator == 0) {
            throw runtime_error("Division by zero impedance");
        }

        return Complex(
            (real * c.real + imag * c.imag) / denominator,
            (imag * c.real - real * c.imag) / denominator
        );
    }

    bool operator==(const Complex& c) const {
        return real == c.real && imag == c.imag;
    }

    double magnitude() const {
        return sqrt(real * real + imag * imag);
    }

    friend ostream& operator<<(ostream& out, const Complex& c) {

        out << fixed << setprecision(2);

        out << c.real;

        if (c.imag >= 0) {
            out << " + j" << c.imag;
        } else {
            out << " - j" << -c.imag;
        }

        return out;
    }
};

int main() {

    try {

        Complex resistor(10, 0);

        Complex inductor(0, 20);

        Complex capacitor(0, -5);

        Complex series = resistor + inductor + capacitor;

        cout << "Resistor Impedance: "
             << resistor << endl;

        cout << "Inductor Impedance: "
             << inductor << endl;

        cout << "Capacitor Impedance: "
             << capacitor << endl;

        cout << "\nSeries Impedance: "
             << series << endl;

        cout << "Series Magnitude: "
             << series.magnitude() << endl;

        Complex z1(10, 0);

        Complex z2(0, 10);

        Complex parallel = (z1 * z2) / (z1 + z2);

        cout << "\nParallel Impedance: "
             << parallel << endl;

        cout << "Parallel Magnitude: "
             << parallel.magnitude() << endl;

        Complex a(5, 3);

        Complex b(2, 1);

        cout << "\nAddition: "
             << a + b << endl;

        cout << "Subtraction: "
             << a - b << endl;

        cout << "Multiplication: "
             << a * b << endl;

        cout << "Division: "
             << a / b << endl;

        cout << boolalpha;

        cout << "Equality: "
             << (a == b) << endl;

        Complex zero(0, 0);

        cout << "\nDivision by Zero Test: "
             << a / zero << endl;

    }
    catch (const exception& e) {

        cout << "Error: " << e.what() << endl;
    }

    return 0;
}
