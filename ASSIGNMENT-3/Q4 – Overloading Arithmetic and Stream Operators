#include <iostream>
#include <iomanip>
using namespace std;

class Money {
private:
    long long paise;

public:
    Money(long long rupees = 0, int p = 0)
        : paise(rupees * 100 + p) {}

    Money operator+(const Money& other) const {
        Money result;
        result.paise = paise + other.paise;
        return result;
    }

    Money operator-(const Money& other) const {
        Money result;
        result.paise = paise - other.paise;
        return result;
    }

    Money& operator+=(const Money& other) {
        paise += other.paise;
        return *this;
    }

    bool operator==(const Money& other) const {
        return paise == other.paise;
    }

    bool operator<(const Money& other) const {
        return paise < other.paise;
    }

    friend ostream& operator<<(ostream& out, const Money& m) {
        long long value = m.paise;
        if (value < 0) {
            out << "-Rs ";
            value = -value;
        } else {
            out << "Rs ";
        }

        out << value / 100 << "."
            << setw(2) << setfill('0')
            << value % 100 << setfill(' ');

        return out;
    }

    friend istream& operator>>(istream& in, Money& m) {
        long long rupees;
        int p;

        if (in >> rupees >> p) {
            if (p >= 0 && p <= 99) {
                m.paise = rupees * 100 + p;
            } else {
                in.setstate(ios::failbit);
            }
        }

        return in;
    }
};

int main() {

    Money a(120, 75);
    Money b(79, 25);

    Money c = a + b;

    cout << c << endl;

    cout << boolalpha << (c == Money(200)) << endl;

    Money x(0, 75);
    Money y(0, 50);

    Money z = x + y;

    cout << "Paise Carry Result: " << z << endl;

    Money total(500);

    total += a;

    cout << "Total: " << total << endl;

    Money difference = x - y;

    cout << "Difference: " << difference << endl;

    cout << "Comparison: " << (x < y) << endl;

    return 0;
}
