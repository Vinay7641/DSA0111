#include <iostream>
#include <iomanip>
#include <limits>
using namespace std;

int main() {

    int hour;

    cout << "Enter journey hour (0-23): ";

    while (!(cin >> hour) || hour < 0 || hour > 23) {

        cout << "Invalid hour. Enter again: ";

        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
    }

    long long balance;

    cout << "Enter card balance in rupees: ";

    while (!(cin >> balance) || balance < 0) {

        cout << "Invalid balance. Enter again: ";

        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
    }

    bool peak =
        (hour >= 8 && hour < 10) ||
        (hour >= 17 && hour < 20);

    long long fare = peak ? 1200 : 1000;

    long long balancePaise = balance * 100;

    bool accepted =
        balancePaise >= fare &&
        balancePaise - fare >= 5000;

    cout << "\n----- JOURNEY REPORT -----\n";

    cout << "Hour: " << hour << ":00" << endl;

    cout << "Period: "
         << (peak ? "Peak" : "Off-Peak")
         << endl;

    cout << fixed << setprecision(2);

    cout << "Fare: Rs " << fare / 100.0 << endl;

    cout << "Status: "
         << (accepted ? "Accepted" : "Denied")
         << endl;

    cout << "Remaining Balance: Rs "
         << (accepted
             ? (balancePaise - fare) / 100.0
             : balancePaise / 100.0)
         << endl;

    return 0;
}
